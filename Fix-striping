var erode = function(img) {
  var distance = 5000;
  var mask = img.mask()
  var d = mask.not().unmask(1).fastDistanceTransform(distance).sqrt()  //.multiply(ee.Image.pixelArea().sqrt())
  return img.mask(d.gt(distance))
}

