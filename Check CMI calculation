]);


// Aggregate --------------------------------------------------------
// Filter
var minyear = 2012;
var maxyear = 2012;
var minmonth = 6;
var maxmonth = 10;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

terra = terra
  .filter(ee.Filter.calendarRange(2012, 2012, 'year'));

// List of years and months
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
// DAYMET
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                              ['tmin', 'tmax', 'prcp']);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);

// TERRA
terra = terra
    .map(cmiTer.calcETMAX)
    .map(cmiTer.calcETMIN)
    .map(cmiTer.calcETDEW)
    .map(cmiTer.calcVPD)
    .map(cmiTer.calcTAVG515)
    .map(cmiTer.calcKTRF)
    .map(cmiTer.calcPET)
    .map(cmiTer.calcCMI);


// Compare ---------------------------------------------------------
// DAYMET
var filterDay6 = aggDaymet
  .filter(ee.Filter.eq('month', 6))
  .first();

var filterDay10 = aggDaymet
  .filter(ee.Filter.eq('month', 10))
  .first();

var calcDay6 = filterDay6
  .select('CMI')
  .rename('cmi6')
