  ee.Image('users/robitalec/CFS/cmi60_06_2012').rename('cmi'),
  ee.Image('users/robitalec/CFS/pcp60_06_2012').rename('pcp'),
  ee.Image('users/robitalec/CFS/mint60_06_2012').rename('mint')
]);

var ref10 = ee.Image([
