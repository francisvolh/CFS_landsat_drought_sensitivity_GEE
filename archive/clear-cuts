var lc = ee.ImageCollection("projects/sat-io/open-datasets/CA_FOREST_LC_VLCE2");

Map.addLayer(lc)

var mask_classes = function(img) {
	return img.updateMask(
		img.expression('lc == 50 || lc == 81 || lc == 210 || lc == 220 || lc == 230',
		{lc: img.select('b1')})
	).select(['b1'], ['land_cover']);
};

lc = lc.map(mask_classes)

Map.addLayer(lc.reduce(ee.Reducer.count()))

Map.addLayer(lc.reduce(ee.Reducer.count()).eq(36))
