// --- Data ---
var ctef = ee.FeatureCollection('users/robitalec/CFS/CTEF_Ecoregions');

// GLDAS-2.1: Global Land Data Assimilation System
var gldas = ee.ImageCollection("NASA/GLDAS/V021/NOAH/G025/T3H");

// FLDAS
var fldas = ee.ImageCollection("NASA/FLDAS/NOAH01/C/GL/M/V001");

// Land cover (MODIS)
// LC_Type1: Annual International Geosphere-Biosphere Programme (IGBP) classification
// LC_Type2: Annual University of Maryland (UMD) classification
// LC_Type3: Annual Leaf Area Index (LAI) classification
// LC_Type4: Annual BIOME-Biogeochemical Cycles (BGC) classification
// LC_Type5: Annual Plant Functional Types classification
var lc = ee.ImageCollection("MODIS/006/MCD12Q1");



// --- Filters and masks ---
// Only three ecoregions (for now)
ctef = ctef.filter(ee.Filter.inList('REG_ID', ['CL13R02', 'CL13R03', 'CL13R04']));


// Smaller for now
gldas = gldas.limit(1).aside(print)
  .filter(ee.Filter.dayOfYear(190, 210))
  .filter(ee.Filter.date('2010-01-01', '2011-01-01'))


// Only forests, using plan functional types for now
// Using 2015 image only for now
lc = lc
  .filter(ee.Filter.date('2015-01-01', '2016-01-01'))
  .first()
  .select('LC_Type5');

lc = lc.gte(1).and(lc.lte(4));


// --- Functions ---
// Calculate CMI
function calcCMI (im) {
  return ee.Image(im.select('potential_evaporation')
            .subtract(im.select('total_precipitation')))
            .rename('cmi');
}

// Stratified sampling of features 
function stratifiedFeatureSample (ft) {
  return ee.FeatureCollection.randomPoints(ft.geometry(), 25);
}


// --- Sampling points ---
// Stratified sample of each ecoregion
var points = ctef.map(stratifiedFeatureSample).flatten();




// --- Map ---
Map.addLayer(ctef)
Map.addLayer(points)
Map.addLayer(fldas.limit(1))

