var minyear = 1980;
var maxyear = 2019;

var listyear = ee.List.sequence(minyear, maxyear);

exports.fireMasks = function(fires, years) {
  return ee.ImageCollection.fromImages(years.map(function(yr) {
    return ee.Image([
      fires.filter(ee.Filter.rangeContains('YEAR', yr, yr - 5))
           .
      ]).set('year', yr);
  }));
};

