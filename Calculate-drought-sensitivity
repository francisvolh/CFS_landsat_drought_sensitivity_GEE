// Modules ----------------------------------------------------------
var agg = require('users/robitalec/CFS:modules/aggregate.js');
var cmi = require('users/robitalec/CFS:modules/cmi.js');
var baseline = require('users/robitalec/CFS:modules/baseline.js');
var fire = require('users/robitalec/CFS:modules/fire.js');
var sensitivity = require('users/robitalec/CFS:modules/sensitivity.js');


// Data -------------------------------------------------------------
// DAYMET
var daymet = ee.ImageCollection("NASA/ORNL/DAYMET_V3");

// CTEF regions
var ctef = ee.FeatureCollection('users/robitalec/CFS/CTEF_Ecoregions');
ctef = ctef.filter(ee.Filter.stringContains('ZONE_EN', 'Arctic').not());

// Aggregate --------------------------------------------------------
// Filter
var minyear = 1980;
var maxyear = 2019;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'));

// List of years and months
var months = ee.List.sequence(1, 12);
var years = ee.List.sequence(minyear, maxyear);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                             ['tmin', 'tmax', 'prcp']);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);


// Calculate baseline -----------------------------------------------
var percentiles = [5, 10, 20];
var means = baseline.antecedentMeans(aggDaymet, 'CMI', years);
var drought = baseline.gtPercentile(means, percentiles);
drought = drought.filter(ee.Filter.neq('year', 1980));

// Fire -------------------------------------------------------------
var firepol = ee.FeatureCollection("users/robitalec/CFS/NFDB_poly");
var firemask = fire.fireMasks(firepol, years);


// Land Cover ------------------------------------------------------
var lc = ee.Image("ESA/GLOBCOVER_L4_200901_200912_V2_3");

// 210 water, 220 permanent snow and ice, 200 bare areas, 190 urban
lc = lc.updateMask(lc.neq(210).and(
                   lc.neq(220)).and(
                   lc.neq(200)).and(
                   lc.neq(190)))
       .select('landcover');

// EVI/NDVI ---------------------------------------------------------
// Filter MODIS EVI/NDVI
var veg = ee.ImageCollection("MODIS/006/MOD13Q1")
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(7, 7, 'month'));

// Mask fire and land cover, return baseline and drought percentiles EVI/NDVI 
var maskveg = sensitivity.maskVeg(veg, drought, firemask, lc, percentiles);

// Mask where number of observations is <3
var maskcount = sensitivity.maskCount(maskveg);

// Reduce to means
var means = maskcount.reduce(ee.Reducer.mean());

// Drought sensitivity -------------------------------------------
// SP,T,L = [ (baseline EVIP – drought EVIP,T,L) / baseline EVIP ] x 100
// drought sensitivity (S’) = percent decrease in EVI under drought relative to baseline conditions
var droughtSens = sensitivity.droughtSensitivity(means, percentiles);
var pal = ['1facff','e7e7e7','ff3f3f'];
// EVIante3, 1-6-12
var animation = require('users/gena/packages:animation');
var visualized = ee.ImageCollection.fromImages(
  droughtSens.bandNames().map(function(name) {
    return droughtSens.select([name])
                      .visualize({min:-20, max:20, palette:pal})
                      .set('bandname', ee.String(name));
  })
);
// animation.animate(visualized, {label: 'bandname', maxFrames: 50, timeStep: 1500});


var text = require('users/gena/packages:text');
var annotations = [{position: 'left', offset: '50%', margin: '5%', property: 'bandname', scale: Map.getScale()* 0.8,
   fontSize: 42, fontType: 'Consolas'
}];
var annotated = visualized.map(function(img) {
  return text.annotateImage(img, {forceRgbOutput: true}, geometry.bounds(), annotations)
});

var args = {
  dimensions: 2500,
  region: geometry,
  framesPerSecond: 1,
  crs: 'EPSG:4326'
};
print(annotated.getVideoThumbURL(args));
