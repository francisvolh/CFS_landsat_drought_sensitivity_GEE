// Modules
var modules = require('users/robitalec/CFS:modules.js');

// DAYMET
var daymet = ee.ImageCollection('NASA/ORNL/DAYMET_V3');


// Filter
var minyear = 2000;
var maxyear = 2015;
var minmonth = 6;
var maxmonth = 8;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

// List of years and months
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);


// var byYr = modules.aggregateYears(years, daymet, ee.Reducer.mean())
var byMnthYr = modules.aggregateMonthsYears(years, months, daymet, ee.Reducer.mean());

// Map
Map.addLayer(byMnthYr.limit(5).select('tmax_mean'));
