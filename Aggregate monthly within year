// DAYMET
var daymet = ee.ImageCollection('NASA/ORNL/DAYMET_V3')


// Filter
var minyear = 2000;
var maxyear = 2015;
var minmonth = 6;
var maxmonth = 8;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));


// Map over list of years
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);



var byYear = ee.ImageCollection.fromImages(
      years.map(function (yr) {
        return daymet.filter(ee.Filter.calendarRange(yr, yr, 'year'))
                    .select('tmax').mean()
                    .set('years', yr);
}));




var mean_function = function(img) {
  var avg_tmax = img.reduceRegions(Basin, ee.Reducer.mean(),1000);
  return avg_tmax;
};

var tmax_means =  byYear.map(mean_function);

print(tmax_means);

Export.table.toDrive({
collection: tmax_means.flatten(),
description: 'TMAXMeans_export_summer2',
fileNamePrefix: 'TMAX_Means_summer_Goat',
});

