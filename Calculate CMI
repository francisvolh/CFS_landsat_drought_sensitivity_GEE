// Modules ----------------------------------------------------------
var agg = require('users/robitalec/CFS:modules/aggregate.js');
var cmi = require('users/robitalec/CFS:modules/cmi.js');

// Data -------------------------------------------------------------
// DAYMET
var daymet = ee.ImageCollection("NASA/ORNL/DAYMET_V3");

// DEM
var dem = ee.ImageCollection("NRCan/CDEM");

dem = dem.filterBounds(geometry)
        .mosaic();


// Aggregate --------------------------------------------------------
// Filter
var minyear = 2010;
var maxyear = 2015;
var minmonth = 6;
var maxmonth = 8;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

// List of years and months
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                              ['tmin', 'tmax', 'prcp']);

// Subset for now *****
// aggDaymet = aggDaymet.filter(ee.Filter.eq('month', 6)).limit(3);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);


// Map -------------------------------------------------------------
Map.addLayer(aggDaymet.select('CMI'), null, 'CMI')
Map.addLayer(dem, null, 'dem')


// Chart -----------------------------------------------------------
var ctef = ee.FeatureCollection('users/robitalec/CFS/CTEF_Ecoregions')
ctef = ctef.filter(ee.Filter.inList('REG_ID', ['CL13R02', 'CL13R03', 'CL13R04']))
var points = ee.FeatureCollection.randomPoints(ctef, 25)
// ui.Chart.image.seriesByRegion(imageCollection, regions, reducer, band, scale, xProperty, seriesProperty)
var ts = ui.Chart.image.seriesByRegion({
  imageCollection: aggDaymet,
  regions: points,
  reducer: ee.Reducer.mean(),
  band: 'CMI',
  scale: 500,
  xProperty: 'month',
  seriesProperty: 'year'
});
print(ts);