/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var geometry = 
    /* color: #d63000 */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[-118.84741504382451, 59.1655245395827],
          [-118.84741504382451, 51.00098107439307],
          [-109.97046191882451, 51.00098107439307],
          [-109.97046191882451, 59.1655245395827]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/
// Modules ----------------------------------------------------------
var agg = require('users/robitalec/CFS:modules/aggregate.js');
var cmi = require('users/robitalec/CFS:modules/cmi.js');

// Data -------------------------------------------------------------
// DAYMET
var daymet = ee.ImageCollection("NASA/ORNL/DAYMET_V3");

// DEM
var dem = ee.ImageCollection("NRCan/CDEM");

dem = dem.filterBounds(geometry)
        .mosaic();


// Aggregate --------------------------------------------------------
// Filter
var minyear = 2012;
var maxyear = 2012;
var minmonth = 6;
var maxmonth = 6;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

// List of years and months
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                              ['tmin', 'tmax', 'prcp']);

// Subset for now *****
// aggDaymet = aggDaymet.filter(ee.Filter.eq('month', 6)).limit(3);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);


// Compare ---------------------------------------------------------
var truth = ee.Image('users/robitalec/CFS/cmi60_06').rename('CMItruth');
var only = aggDaymet.select('CMI').first().rename('daymetCMI').clip(truth.geometry());


// TERRA
var cmiTer = require('users/robitalec/CFS:modules/cmi-terraclimate.js');
var terra = ee.ImageCollection("IDAHO_EPSCOR/TERRACLIMATE")
    .filter(ee.Filter.calendarRange(6, 6, 'month'))
    .filter(ee.Filter.calendarRange(2012, 2012, 'year'))
    .map(cmiTer.calcETMAX)
    .map(cmiTer.calcETMIN)
    .map(cmiTer.calcETDEW)
    .map(cmiTer.calcVPD)
    .map(cmiTer.calcTAVG515)
    .map(cmiTer.calcKTRF)
    .map(cmiTer.calcPET)
    .map(cmiTer.calcCMI)
    
    .first()
    .select('CMI').rename('terraCMI')
    .clip(truth.geometry())

// Difs
var difTerra = truth.subtract(terra).abs().rename('difTerra')
var difFalse = only.subtract(terra).divide(only.add(terra)).rename('difTerra')
var dif = truth.subtract(only).abs().rename('dif')


// Map -------------------------------------------------------------
var vis = {'min': -10, 'max': 15}
Map.addLayer(only, vis, 'CMI');
Map.addLayer(truth, vis, 'truth')
Map.addLayer(terra, vis, 'terra')

var difvis = {'min':-1, 'max':1}
Map.addLayer(dif, null, 'dif')
Map.addLayer(aggDaymet.select('tmax'), null, 'tmax')
Map.addLayer(difTerra, null, 'difTerra')
// Map.addLayer(difFalse, difvis, 'difFalse')


// Chart -----------------------------------------------------------
var col = ee.Image([only, truth]);

var points = ee.FeatureCollection.randomPoints(col.geometry(), 100)
// print(col)
var chart = ui.Chart.feature.byFeature(col.reduceRegions(points, ee.Reducer.mean()))
// print(chart)


// Export ----------------------------------------------------------
var out = aggDaymet.first().addBands([truth, dem])
// print(out)
var outred = out.reduceRegions({
  'collection': points, 
  'reducer': ee.Reducer.mean(), 
  'scale': 500
})
// print(outred.first())
Export.table.toDrive(outred)



var outcalc = out.addBands(
  out.expression(
    // '93 * VPD * KTRF * (2.71828182846 ** 
    '2.71828182846 ** (1.0 * ELEV / 9300)', {
      'VPD': out.select('VPD'),
      'KTRF': out.select('KTRF'),
      'ELEV': ee.Image("MERIT/DEM/v1_0_3")
      // ee.ImageCollection("NRCan/CDEM").select('elevation').mosaic()
    }).rename('PETagain'))
    
