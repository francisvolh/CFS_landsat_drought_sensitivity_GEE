      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[-123.37378223132451, 59.03010974273001],
          [-123.37378223132451, 49.93815589702714],
          [-110.54175098132451, 49.93815589702714],
          [-110.54175098132451, 59.03010974273001]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/
// Modules ----------------------------------------------------------
var agg = require('users/robitalec/CFS:modules/aggregate.js');
var cmi = require('users/robitalec/CFS:modules/cmi.js');
var cmiTer = require('users/robitalec/CFS:modules/cmi-terraclimate.js');

// Data -------------------------------------------------------------
// DAYMET
var daymet = ee.ImageCollection("NASA/ORNL/DAYMET_V3");

var terra = ee.ImageCollection("IDAHO_EPSCOR/TERRACLIMATE");

// DEM
// var dem = ee.ImageCollection("NRCan/CDEM")
//                    .filterBounds(geometry)
//                    .mosaic();
var dem = ee.Image("MERIT/DEM/v1_0_3");

var ref6 = ee.Image([
  ee.Image('users/robitalec/CFS/maxt60_06_2012').rename('maxt'),
  ee.Image('users/robitalec/CFS/cmi60_06_2012').rename('cmi'),
  ee.Image('users/robitalec/CFS/pcp60_06_2012').rename('pcp'),
  ee.Image('users/robitalec/CFS/mint60_06_2012').rename('mint')
]);

var ref10 = ee.Image([
  ee.Image('users/robitalec/CFS/maxt60_10_2012').rename('maxt'),
  ee.Image('users/robitalec/CFS/cmi60_10_2012').rename('cmi'),
  ee.Image('users/robitalec/CFS/pcp60_10_2012').rename('pcp'),
  ee.Image('users/robitalec/CFS/mint60_10_2012').rename('mint')
]);


// Aggregate --------------------------------------------------------
// Filter
var minyear = 2012;
var maxyear = 2012;
var minmonth = 6;
var maxmonth = 10;

daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'))
  .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

terra = terra
  .filter(ee.Filter.calendarRange(2012, 2012, 'year'));

// List of years and months
var years = ee.List.sequence(minyear, maxyear);
var months = ee.List.sequence(minmonth, maxmonth);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
// DAYMET
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                              ['tmin', 'tmax', 'prcp']);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);

// TERRA
terra = terra
    .map(cmiTer.calcETMAX)
    .map(cmiTer.calcETMIN)
    .map(cmiTer.calcETDEW)
    .map(cmiTer.calcVPD)
    .map(cmiTer.calcTAVG515)
    .map(cmiTer.calcKTRF)
    .map(cmiTer.calcPET)
    .map(cmiTer.calcCMI);


// Compare ---------------------------------------------------------
// DAYMET
var filterDay6 = aggDaymet
  .filter(ee.Filter.eq('month', 6))
  .first();

var filterDay10 = aggDaymet
  .filter(ee.Filter.eq('month', 10))
  .first();

var calcDay6 = filterDay6
  .select('CMI')
  .first()
  .rename('cmi6')
  .clip(geometry);

var calcDay10 = filterDay10
  .select('CMI')
  .rename('cmi10')
  .clip(geometry);


// TERRA
var filterTerra6 = terra
  .filter(ee.Filter.calendarRange(6, 6, 'month'))
  .first();
  
var filterTerra10 = terra
  .filter(ee.Filter.calendarRange(10, 10, 'month'))
  .first();

var calcTerra6 = filterTerra6
    .select('CMI').rename('cmi6Terra')
    .clip(geometry);

var calcTerra10 = filterTerra10
    .first()
    .select('CMI').rename('cmi6Terra')
    .clip(geometry);

// CMI diffs
var difTerra6 = ref6.select('cmi').subtract(calcTerra6).rename('dif-Terra-CMI-6');
var difTerra10 = ref10.select('cmi').subtract(calcTerra10).rename('dif-Terra-CMI-10');

var difDay6 = ref6.select('cmi').subtract(calcDay6).rename('dif-Day-CMI-6');
var difDay10 = ref10.select('cmi').subtract(calcDay10).rename('dif-Day-CMI-10');

// Other variable diffs
var difTerraTmax6 = ref6.select('maxt').subtract(filterTerra6.select('tmax').first()).rename('dif-Terra-Tmax-6');
var difTerraTmax10 = ref10.select('maxt').subtract(filterTerra10.select('tmax').first()).rename('dif-Terra-Tmax-10');

var difTerraTmin6 = ref6.select('mint').subtract(filterTerra6.select('tmin').first()).rename('dif-Terra-Tmin-6');
var difTerraTmin10 = ref10.select('mint').subtract(filterTerra10.select('tmin').first()).rename('dif-Terra-Tmin-10');

var difTerraPcp6 = ref6.select('pcp').subtract(filterTerra6.select('prcp').first()).rename('dif-Terra-Pcp-6');
var difTerraPcp10 = ref10.select('pcp').subtract(filterTerra10.select('prcp').first()).rename('dif-Terra-Pcp-10');

var difDayTmax6 = ref6.select('maxt').subtract(filterDay6.select('tmax').first()).rename('dif-Day-Tmax-6');
var difDayTmax10 = ref10.select('maxt').subtract(filterDay10.select('tmax').first()).rename('dif-Day-Tmax-10');

var difDayTmin6 = ref6.select('mint').subtract(filterDay6.select('tmin').first()).rename('dif-Day-Tmin-6');
var difDayTmin10 = ref10.select('mint').subtract(filterDay10.select('tmin').first()).rename('dif-Day-Tmin-10');

var difDayPcp6 = ref6.select('pcp').subtract(filterDay6.select('prcp').first()).rename('dif-Day-Pcp-6');
var difDayPcp10 = ref10.select('pcp').subtract(filterDay10.select('prcp').first()).rename('dif-Day-Pcp-10');

// Combine diffs
var combTerra6 = ee.Image([difTerra6, difTerraTmax6, difTerraTmin6, difTerraPcp6])
var combDay6 = ee.Image([difDay6, difDayTmax6, difDayTmin6, difDayPcp6])

var combTerra10 = ee.Image([difTerra10, difTerraTmax10, difTerraTmin10, difTerraPcp10])
var combDay10 = ee.Image([difDay10, difDayTmax10, difDayTmin10, difDayPcp10])


// Map -------------------------------------------------------------
// var difvis = {'min':-1, 'max':1}



// Chart -----------------------------------------------------------
var col = ee.Image([ref6, ref10, calcTerra6, calcTerra10, calcDay6, calcDay10,
                    combTerra6, combDay6, combTerra10, combDay10]);

var points = ee.FeatureCollection.randomPoints(col.geometry(), 100)
var chart = ui.Chart.feature.byFeature(col.reduceRegions(points, ee.Reducer.mean()))
