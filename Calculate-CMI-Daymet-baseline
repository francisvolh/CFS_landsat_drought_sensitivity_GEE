// Modules ----------------------------------------------------------
var agg = require('users/robitalec/CFS:modules/aggregate.js');
var cmi = require('users/robitalec/CFS:modules/cmi.js');

// Data -------------------------------------------------------------
// DAYMET
var daymet = ee.ImageCollection("NASA/ORNL/DAYMET_V3");

// DEM
var dem = ee.ImageCollection("NRCan/CDEM");

dem = dem.filterBounds(geometry)
        .mosaic();


// Aggregate --------------------------------------------------------
// Filter
var minyear = 2010;
var maxyear = 2019;


daymet = daymet
  .filter(ee.Filter.calendarRange(minyear, maxyear, 'year'));


// Three periods
// - [ ]  loop through each combination july 1 and year
// - [ ]  make three variables
// - [ ]  3 month = july 1 - 3 months
// - [ ]  6 month = july - 6 months
// - [ ]  12 month = july 1 - 1 year, minus the year
// - [ ]  calculate percentiles
// - [ ]  output a 3, 6, 12 for each as a image bands and each of the percentiles
var period3min = 4
var period3min = 4

// .filter(ee.Filter.calendarRange(minmonth, maxmonth, 'month'));

// List of years and months
var months = ee.List.sequence(1, 12);
var years = ee.List.sequence(minyear, maxyear);

// Reducer
var reducer = ee.Reducer.mean()
  .combine(ee.Reducer.sum(), null, true);

// Aggregate monthly for each year
var aggDaymet = agg.aggregateMY(years, months, daymet, reducer);

// Calculate CMI ----------------------------------------------------
aggDaymet = aggDaymet.select(['tmin_mean', 'tmax_mean', 'prcp_sum'],
                              ['tmin', 'tmax', 'prcp']);

aggDaymet = aggDaymet
  .map(cmi.calcETMAX)
  .map(cmi.calcETMIN)
  .map(cmi.calcETDEW)
  .map(cmi.calcVPD)
  .map(cmi.calcTAVG515)
  .map(cmi.calcKTRF)
  .map(cmi.calcPET)
  .map(cmi.calcCMI);


var antemax = 6;
var ante3min = 3;
var ante6min = 1;

var zzz = ee.ImageCollection.fromImages(
  years.map(function(yr) {
    var ante12max = ee.Date.fromYMD(yr, antemax, 1);
    
    return ee.Image([
      // Antecedent: 3
      aggDaymet.filter(ee.Filter.eq('year', yr))
              .filter(ee.Filter.rangeContains('month', ante3min, antemax))
              .select(['CMI'], ['CMI_ante3'])
              .reduce(ee.Reducer.percentile([5, 10, 15])),
               
      // Antecedent: 6
      aggDaymet.filter(ee.Filter.eq('year', yr))
              .filter(ee.Filter.rangeContains('month', ante6min, antemax))
              .select(['CMI'], ['CMI_ante6'])
              .reduce(ee.Reducer.percentile([5, 10, 15])),
               
      // Antecedent: 12
      aggDaymet.filter(ee.Filter.date(ante12max.advance(-1, 'year'),
                                      ante12max))
              .select(['CMI'], ['CMI_ante12'])
              .reduce(ee.Reducer.percentile([5, 10, 15]))
      ]).set('year', yr);
  })
);

print(zzz)
